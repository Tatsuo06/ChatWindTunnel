# Copy this file to .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (recommended)
DATABASE_URL=postgresql+asyncpg://chatwt:chatwt@localhost:5432/chatwt
# SQLite (quick local testing, no PostgreSQL required)
# DATABASE_URL=sqlite+aiosqlite:///./data/chatwt.db

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── LLM ───────────────────────────────────────────────────────────────────────
# LM Studio (local, default)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=your-model-name
LLM_API_KEY=lm-studio

# Claude API
# LLM_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-sonnet-4-6
# LLM_API_KEY=sk-ant-...

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...

# ── Cluster (PBS/Torque via SSH) ───────────────────────────────────────────────
# Leave CLUSTER_USER empty to run jobs locally (requires FOAM_LOCAL_APP below).
# Set CLUSTER_USER to enable SSH-based PBS cluster submission.
CLUSTER_USER=
CLUSTER_HOST=your-cluster-hostname-or-ip
CLUSTER_SSH_KEY=~/.ssh/id_rsa
# Remote directory where case directories are created ({user} → CLUSTER_USER)
CLUSTER_WORK_DIR=/home/{user}/chatwt_cases
# Full path to OpenFOAM bashrc on the cluster
CLUSTER_FOAM_MODULE=/path/to/OpenFOAM-v2206/etc/bashrc
CLUSTER_N_PROCESSORS=16
TRANSPORT_MODE=scp   # "scp" or "nfs"

# ── Local OpenFOAM (only used when CLUSTER_USER is empty) ─────────────────────
# macOS: path to OpenFOAM .app bundle.
# Leave blank or omit to disable local job execution entirely.
FOAM_LOCAL_APP=/Applications/OpenFOAM-v2206.app

# ── Frontend ──────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
