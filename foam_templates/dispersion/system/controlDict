FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     buoyantBoussinesqSimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         500;

deltaT          1;

writeControl    timeStep;

writeInterval   100;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    #include "streamLines"
    // Disabled: excluded from the results rsync (~280 MB/case), so the Results
    // tab's wall-bounded streamlines are unavailable for cluster runs anyway.
    // Re-enable this line (and the rsync excludes in cluster_runner.py) to use
    // it — system/wallBoundedStreamLines is still present.
    // #include "wallBoundedStreamLines"
    #include "cuttingPlane"
    #include "forceCoeffs"
    // Disabled: EnSight output is never read by ChatWindTunnel (visualization
    // uses VTK/ + postProcessing/), but cost ~1.4 GB of cluster disk per case.
    // Re-enable this line to write it (system/ensightWrite is still present).
    // #include "ensightWrite"
    #include "limitK"
}


