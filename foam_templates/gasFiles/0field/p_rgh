FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    outlet
    {
        type            prghPressure;
        p               uniform 101325;
        value           $internalField;
    }

    lowerWall
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    motorBike
    {
        type            fixedFluxPressure;
        value           $internalField;
    }

    upperWall
    {
        type            slip;
    }

    frontAndBack
    {
        type            slip;
    }

    "proc.*"
    {
        type            processor;
    }
}


