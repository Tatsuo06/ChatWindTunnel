FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs            (OpenFOAM fieldFunctionObjects);

application     rhoReactingBuoyantFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.7;

deltaT          1e-4;

// Courant-adaptive stepping: seeding a transient compressible LES from a
// steady field gives a violent start-up. A fixed step lets the local Courant
// number spike (seen ~400) and the run diverges (k/omega blow up -> FPE).
// The step shrinks to hold the Courant number bounded, then grows back to the
// requested ceiling once settled. (Do NOT name the edited keys in this comment.)
adjustTimeStep  yes;

maxCo           1.0;

maxDeltaT       1e-4;

writeControl    timeStep;

writeInterval   1000;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;


functions
{
    #include "forceCoeffs"
    #include "cuttingPlane"
    #include "streamLines"
}


