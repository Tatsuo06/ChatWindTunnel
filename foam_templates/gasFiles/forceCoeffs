// Compressible force coefficients for the gas-dispersion stage. Forces are
// integrated from the real density and absolute pressure fields; the reference
// density below normalises the coefficients to the far-field air value so they
// match the incompressible aero LES convention and the two runs are directly
// comparable. (Do NOT name the edited keys in this comment — they get rewritten.)
forceCoeffs1
{
    type            forceCoeffs;

    libs            (forces);

    writeControl    timeStep;
    timeInterval    1;

    log             yes;

    patches         (motorBikeGroup);
    rho             rho;
    rhoInf          1.161;
    liftDir         (0 0 1);
    dragDir         (1 0 0);
    CofR            (0.72 0 0);
    pitchAxis       (0 1 0);
    magUInf         20;
    lRef            1.42;
    Aref            0.75;
}


