FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Gas release: injects mass and GAS species together (mass-consistent).
// Point and rates are rewritten by case_builder from source_position /
// source_rate parameters.
gasSource
{
    type            scalarSemiImplicitSource;
    active          yes;

    volumeMode      absolute;
    selectionMode   points;

    points
    (
        (0.0 0.0 1.0)
    );

    sources
    {
        rho         (1.0 0);
        GAS         (1.0 0);
    }
}


