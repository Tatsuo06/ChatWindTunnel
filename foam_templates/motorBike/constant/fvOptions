FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Runaway-flow guard: clips unphysical local velocity spikes that seed the
// low-speed divergence feedback (local spike -> k production -> nut ->
// pressure failure). The ceiling is rewritten by case_builder to 4x the wind
// speed, outside any physical solution, so it only acts on numerical blow-up.
limitU
{
    type            limitVelocity;
    active          yes;
    selectionMode   all;
    max             80;
}


