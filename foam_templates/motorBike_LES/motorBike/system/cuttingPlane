cuttingPlane
{
    type            surfaces;
    libs            (sampling);
    // timeStep control so Phase 2 (LES) writes animation frames more often
    // than the volume writeInterval; case_builder overrides the interval
    // from the les_anim_interval parameter.
    writeControl    timeStep;
    writeInterval   100;

    surfaceFormat   vtk;
    fields          ( p U );

    interpolationScheme cellPoint;

    surfaces
    {
        yNormal
        {
            type        cuttingPlane;
            point       (0 0 0);
            normal      (0 1 0);
            interpolate true;
        }
    }
}


